# Shark — шаблон конфигурации для новой установки
# Только если .env ещё нет: скопируйте этот шаблон и заполните свои значения.
# Существующую .env не перезаписывайте; корпоративные дополнения — через SHARK_ENV_FILE.
# Секреты задавайте в UI, окружении или закрытом внешнем файле.
# Вход — через Jira или локальную учётку; API использует Bearer-сессии.

# ── UI Defaults ───────────────────────────────────────────────
DEFAULT_PLATFORM=W
DEFAULT_FEATURE=
LLM_PROVIDER=gigachat

# ── GigaChat: три подключения ─────────────────────────────────
# Удобнее настраивать в UI (Настройки → LLM Провайдеры): «Подключиться» → выбрать модель → «Сохранить».
# Ключ авторизации — Base64 из https://developers.sber.ru/studio (проект GigaChat API → Настройки API).
# Giga Личный — публичный API по ключу, scope GIGACHAT_API_PERS
GIGACHAT_PERS_AUTH_KEY=
GIGACHAT_PERS_MODEL=
# Giga Corp — публичный API по ключу юрлица, scope GIGACHAT_API_CORP (по факту) или GIGACHAT_API_B2B (пакеты)
GIGACHAT_CORP_AUTH_KEY=
GIGACHAT_CORP_SCOPE=GIGACHAT_API_CORP
GIGACHAT_CORP_MODEL=
# OAuth для Личного и Corp
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Giga IFT — стенд по клиентскому сертификату
GIGACHAT_BASE_URL=https://gigachat-ift.sberdevices.delta.sbrf.ru/api/v1
GIGACHAT_MODEL=
# GIGACHAT_CA_CERT_PATH=/path/to/ca.pem
# GIGACHAT_CLIENT_CERT_PATH=/path/to/client.crt
# GIGACHAT_CLIENT_KEY_PATH=/path/to/client.key
# Прежний GIGACHAT_AUTH_KEY (+ GIGACHAT_SCOPE) при первом запуске сам переносится в Личный или Corp

# ── DeepSeek (опционально) ────────────────────────────────────
# Получить ключ: https://platform.deepseek.com
DEEPSEEK_AUTH_TYPE=api_key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Для подключения через сертификат:
# DEEPSEEK_AUTH_TYPE=certificate
# DEEPSEEK_CA_CERT_PATH=/path/to/ca.pem
# DEEPSEEK_CLIENT_CERT_PATH=/path/to/client.crt
# DEEPSEEK_CLIENT_KEY_PATH=/path/to/client.key

# Дополнительные LLM добавляются через UI: Настройки → Дополнительные LLM.
# Поддерживается chat/completions-compatible endpoint через API key или сертификат.

# Для контуров, где по политике безопасности разрешён только GigaChat
# (см. категорию "LLM" в Руководстве по доступу к внешним ресурсам):
# отключает подключение/использование любых сторонних провайдеров —
# и на бэкенде (LLMClient), и в UI настроек.
# GIGACHAT_ONLY=1

# ── Kafka (общий fallback для KafkaClient + дефолт для Kafka-Метрик) ──
# Подключение к Kafka для алертов теперь описывается прямо в коде
# Jupyter-скрипта (см. раздел «Алерты»), настройки здесь не участвуют.
# Адрес брокера (один или несколько через запятую)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Протокол: PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# SASL-механизм: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 (если SASL_*)
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Путь к CA-файлу (если SSL/SASL_SSL)
KAFKA_SSL_CAFILE=
# JWT-секрет для A2A-протокола — сгенерировать криптостойкий ключ:
#   python -c "import secrets; print(secrets.token_hex(32))"
A2A_JWT_SECRET=

# ── Ревизор стендов ───────────────────────────────────────────
# Основная настройка делается в UI: Настройки → Ревизор — API стенды.
# Там задаются имя стенда, Base URL, auth и выбранные методы сравнения.
# Если UI-конфигурация пуста — Ревизор работает на mock-данных.
# Старые env-переменные оставлены как read-only fallback для статуса стендов.
REVISOR_NT_URL=
REVISOR_NT_TOKEN=
REVISOR_NT_NAMESPACE=
REVISOR_MAJORCHECK_URL=
REVISOR_MAJORCHECK_TOKEN=
REVISOR_MAJORCHECK_NAMESPACE=
REVISOR_MAJORGO_URL=
REVISOR_MAJORGO_TOKEN=
REVISOR_MAJORGO_NAMESPACE=

# ── База данных ───────────────────────────────────────────────
# SQLite — без Docker, файл создаётся автоматически рядом с приложением:
DATABASE_URL=sqlite:///./simpletest.db
# PostgreSQL — раскомментировать и заменить при использовании PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://simpletest:simpletest@localhost:5432/metrics

# ── Корпоративные SSL-сертификаты (Sber BIG IP proxy) ─────────
# Нужно только в корпоративной сети с TLS-инспекцией.
# Сначала соберите bundle: bash certs/build_bundle.sh
# SSL_CERT_FILE=./certs/ca-bundle.pem
# REQUESTS_CA_BUNDLE=./certs/ca-bundle.pem

# ── Прочее ────────────────────────────────────────────────────
USE_REAL_LLM=1

# Мок-режим: корпоративные API и LLM — заготовки, данные в data_mock/ (см. README.md). Kafka/JDBC не подменяются.
# SHARK_MOCK=1

# ── Логи через MCP ──────────────────────────────────────────
# Таймаут одного вызова MCP и общий лимит фоновой операции в секундах.
# LOGS_MCP_REQUEST_TIMEOUT=120
# LOGS_MCP_JOB_TIMEOUT=900
# PVS на ИФТ — docs/pvs-mcp.md. Учётка задаётся в «Настройки → Подключения → PVS MCP» или в окружении запуска.
# LOGS_MCP_PROFILE=pvs
# LOGS_MCP_TRANSPORT=stdio
# LOGS_MCP_COMMAND=/home/work/username/.venvs/pvs-mcp/bin/opensearch-mcp-server-py
# LOGS_MCP_STDIO_ARGS='[]'
# LOGS_MCP_STDIO_ENV='["OPENSEARCH_URL","OPENSEARCH_USERNAME","OPENSEARCH_PASSWORD","OPENSEARCH_SSL_VERIFY","OPENSEARCH_CA_CERT_PATH","OPENSEARCH_CLIENT_CERT_PATH","OPENSEARCH_CLIENT_KEY_PATH"]'
# LOGS_MCP_NAMESPACE=sber911-sigma-back
# LOGS_PVS_INDEX=
# LOGS_PVS_FIELDS='{}'
# OPENSEARCH_URL=https://tsles-sber00075.esrt.sber.ru:19200
# OPENSEARCH_USERNAME=pvs_user
# OPENSEARCH_SSL_VERIFY=true
#
# Для других источников через Streamable HTTP укажите URL самого MCP-сервера.
# LOGS_MCP_TRANSPORT=http
# LOGS_MCP_URL=https://logs-mcp.example/mcp
# LOGS_MCP_TOOL=search_logs
# LOGS_MCP_TOKEN=
# LOGS_MCP_CA_FILE=/path/to/corporate-ca.pem
# Карта имён аргументов сверяется с tools/list. Пример:
# LOGS_MCP_ARGS='{"service":"application","namespace":"ns","start":"from","end":"to"}'

# ── Главная и Эфир ───────────────────────────────────────────
# Раскладка общая для команды; обработка очереди доступна всем вошедшим.
# DASHBOARD_EDITORS=16538296
# ETHER_MCP_URL=https://efir.sber.ru/api/platform/api/v1/mcp/mcp/
# ETHER_MCP_HEADERS=Cookie: <только секрет окружения; не добавлять в отслеживаемый .env>
# ETHER_FEED_LOOKBACK_HOURS=72
# ETHER_DIALOGS_TTL=60
# ETHER_MSG_TTL=90
# ETHER_BUDGET=8
# ETHER_REQUEST_TIMEOUT=30
# ETHER_FEED_LIMIT=100
# Почта и встречи используют тот же MCP и ту же сессию Эфира.
# Имена/аргументы сверяются с живым tools/list; инструменты должны объявлять readOnlyHint=true.
# ETHER_MAIL_TOOL=mail_get_messages
# ETHER_MAIL_ARGS='{}'
# ETHER_MEETINGS_TOOL=calendar_get_events
# ETHER_MEETINGS_ARGS='{}'
# ETHER_BROWSER_PROFILE=/home/work/username/.simpletest/ether-web/profile
# MCP_WEB_BROWSER_PATH=/Applications/SberBrowser.app/Contents/MacOS/SberBrowser
# Фактический маппинг PVS ИФТ (20.11.2026): timestamp, не @timestamp; requestId отсутствует.
# LOGS_PVS_INDEX=sber-app-*
# LOGS_PVS_FIELDS='{"namespace":"k8s.namespace.name.keyword","service":"service.name.keyword","timestamp":"timestamp","level":"level.keyword","message":"message","traceId":"mdc.traceId.keyword","stack":"stackTrace"}'
# LOGS_PVS_SERVICES_HOURS=72
# PVS ИФТ требует mTLS. Передайте реальные сертификаты через окружение запуска:
# OPENSEARCH_CA_CERT_PATH=/path/to/pvs-ca.pem
# OPENSEARCH_CLIENT_CERT_PATH=/path/to/pvs-client.pem
# OPENSEARCH_CLIENT_KEY_PATH=/path/to/pvs-client.key
