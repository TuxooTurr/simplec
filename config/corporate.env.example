# Дополнение к действующим настройкам Shark. Здесь нет паролей или Cookie.
# Создать закрытый файл: python scripts/shark_doctor.py --init-env ~/.simpletest/shark-corp.env
# Запуск: SHARK_ENV_FILE=~/.simpletest/shark-corp.env bash start.sh
# Базовый .env не изменяется. Учётку PVS сохраните через UI, секреты ГигаКод — через хранилище окружения.

LOGS_MCP_PROFILE=pvs
LOGS_MCP_TRANSPORT=stdio
# Абсолютный путь к утверждённому MCP после установки из AI-market:
# LOGS_MCP_COMMAND=/absolute/path/to/opensearch-mcp-server-py
LOGS_MCP_STDIO_ARGS=[]
LOGS_MCP_NAMESPACE=sber911-sigma-back
LOGS_PVS_INDEX=sber-app-*
LOGS_PVS_FIELDS='{"namespace":"k8s.namespace.name.keyword","service":"service.name.keyword","timestamp":"timestamp","level":"level.keyword","message":"message","traceId":"mdc.traceId.keyword","stack":"stackTrace"}'
LOGS_PVS_SERVICES_HOURS=72
LOGS_MCP_REQUEST_TIMEOUT=120
LOGS_MCP_JOB_TIMEOUT=900
OPENSEARCH_URL=https://tsles-sber00075.esrt.sber.ru:19200
OPENSEARCH_USERNAME=pvs_user
OPENSEARCH_SSL_VERIFY=true
# OPENSEARCH_CA_CERT_PATH=/absolute/path/to/pvs-ca.pem
# OPENSEARCH_CLIENT_CERT_PATH=/absolute/path/to/pvs-client.pem
# OPENSEARCH_CLIENT_KEY_PATH=/absolute/path/to/pvs-client.key

ETHER_MCP_URL=https://efir.sber.ru/api/platform/api/v1/mcp/mcp/
# Чат, почта и встречи используют эту же сессию. Имена инструментов сверить с tools/list:
# ETHER_MAIL_TOOL=<объявленный инструмент чтения почты>
# ETHER_MAIL_ARGS={}
# ETHER_MEETINGS_TOOL=<объявленный инструмент чтения встреч>
# ETHER_MEETINGS_ARGS={}
ETHER_FEED_LOOKBACK_HOURS=72
ETHER_DIALOGS_TTL=60
ETHER_MSG_TTL=90
ETHER_BUDGET=8
ETHER_REQUEST_TIMEOUT=30
ETHER_FEED_LIMIT=100
# Путь можно не задавать: автоопределение Сбербраузера/Chrome.
# MCP_WEB_BROWSER_PATH=
# ETHER_BROWSER_PROFILE=
# Явный список редакторов Главной (через запятую); чтение и обработка очереди — всей команде.
DASHBOARD_EDITORS=16538296

# Локальный мост GigaCode, только для start.sh --with-gigacode.
# GIGACODE_BRIDGE_KEY=
# GIGACODE_BRIDGE_PY=
# GIGACODE_TOKEN_FILE=
